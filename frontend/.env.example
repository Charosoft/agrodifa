# Copier ce fichier en ".env.local" puis remplir les valeurs.# Seules les variables qui commencent par VITE_ sont visibles dans le navigateur.
# ⚠️ Ne JAMAIS mettre la clé secrète (service_role / secret) ici.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=clé-publique-anon-ou-publishable

# URL du backend Express (local par défaut ; sur Render en production)
VITE_API_URL=http://localhost:4000
