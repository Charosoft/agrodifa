# Site React à une seule page : toute adresse qui n'est pas un vrai fichier ouvre index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Type du fichier d'installation de l'application
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Compression des fichiers texte
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Cache : les fichiers de /assets changent de nom à chaque version, on les garde 1 an.
# La page d'accueil (index.html) est toujours revérifiée pour voir les mises à jour.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>